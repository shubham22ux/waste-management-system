# ==============================================================================
# SmartWaste Server Environment Configuration
# ==============================================================================

# Server Port and Environment
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# MongoDB Configuration (AWS DocumentDB, MongoDB Atlas, or Local)
# ------------------------------------------------------------------------------
# Example for MongoDB Atlas on AWS:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.aws.mongodb.net/smartwaste?retryWrites=true&w=majority
# Example for Amazon DocumentDB:
# MONGODB_URI=mongodb://<username>:<password>@<docdb-cluster-endpoint>:27017/smartwaste?tls=true&tlsCAFile=global-bundle.pem&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false
MONGODB_URI=mongodb://127.0.0.1:27017/smartwaste

# ------------------------------------------------------------------------------
# AWS Cloud Configuration
# ------------------------------------------------------------------------------
# Region where your AWS services (S3, CloudFront, App Runner/EC2) are provisioned
AWS_REGION=us-east-1

# IAM User or Role Credentials (Leave blank if running on EC2/ECS with IAM Instance Profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Amazon S3 Bucket for Media Evidence (Complaints, Fleet Photos)
AWS_S3_BUCKET=smartwaste-complaint-evidence-bucket

# Amazon CloudFront CDN Domain (Optional: for CDN delivery of uploaded photos)
# Example: d123456abcdef8.cloudfront.net
AWS_CLOUDFRONT_DOMAIN=

# Optional S3 Endpoint for LocalStack / MinIO local cloud simulation
# AWS_S3_ENDPOINT=http://localhost:4566

# ------------------------------------------------------------------------------
# Amazon Rekognition AI (Optional Grievance Validation)
# ------------------------------------------------------------------------------
# Set to true to automatically scan uploaded citizen complaint photos for waste
AWS_ENABLE_REKOGNITION=false

# ------------------------------------------------------------------------------
# JWT Authentication Secret
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production
