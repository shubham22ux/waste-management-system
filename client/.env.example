# ==============================================================================
# SmartWaste Client Environment Configuration
# ==============================================================================

# Backend API Base URL (Leave empty if hosted on same domain or reverse proxied)
# Example for AWS App Runner or EC2 backend:
# VITE_API_URL=https://api.your-smartwaste-domain.com
VITE_API_URL=

# Socket.IO Real-time Telemetry URL (Defaults to VITE_API_URL or window.location.origin)
# VITE_SOCKET_URL=https://api.your-smartwaste-domain.com
VITE_SOCKET_URL=
